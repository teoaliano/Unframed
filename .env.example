# Copy this file to ".env" and fill in your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Image model slug. openai/gpt-image-2 calls OpenAI's Images API directly (no LLM overhead).
# Browse others: https://openrouter.ai/models?output_modalities=image
OPENROUTER_MODEL=openai/gpt-image-2

# Where generated images + their .json sidecars are written (relative to project root, or absolute).
OUTPUT_DIR=./output

# Port for the local backend.
PORT=8787
