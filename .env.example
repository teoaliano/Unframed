# Copy this file to ".env" and fill in your key. Everything here can also be set
# in the app: settings icon, top right.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# The three default models. Each node still has its own picker -- these are what a
# fresh node starts on.

# Image model, for the output node's Image tab. openai/gpt-image-2 calls OpenAI's
# Images API directly (no LLM overhead).
# Browse others: https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Text model for text nodes. Must accept image input, since images wired into a text
# node are sent along with the prompt. Browse: https://openrouter.ai/models
OPENROUTER_TEXT_MODEL=google/gemini-3.5-flash-lite

# Video model for the output node's Video tab. Billed per second of output.
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0

# ElevenLabs key, for the audio output node's text-to-speech. A separate vendor
# from OpenRouter, with its own key.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Default model for the audio output node.
ELEVENLABS_MODEL_ID=eleven_v3

# Where generated images + their .json sidecars are written (relative to project root, or absolute).
OUTPUT_DIR=./output

# Port for the local backend. Changing it also means editing the proxy in
# client/vite.config.js, so this one is not in the settings dialog.
PORT=8787
