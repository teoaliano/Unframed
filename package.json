{
  "name": "unframed-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:share": "node scripts/dev.ts --share",
    "engine": "node packages/engine/src/main.ts",
    "web": "pnpm --filter @unframed/web dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:perf": "playwright test performance.spec.ts artifactPerformance.spec.ts glassPerformance.spec.ts largeImages.spec.ts previews.spec.ts",
    "test:bundle": "vitest run --project engine packages/engine/test/bundle.test.ts",
    "build": "node scripts/build.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-darwin-arm64": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-darwin-x64": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-linux-arm64": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-linux-x64": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-linux-x64-musl": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-win32-arm64": "-",
      "@anthropic-ai/claude-agent-sdk>@anthropic-ai/claude-agent-sdk-win32-x64": "-"
    },
    "neverBuiltDependencies": [
      "puppeteer"
    ]
  }
}
